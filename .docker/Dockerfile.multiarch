# syntax=docker/dockerfile:1.7
# BUILDPLATFORM / TARGETPLATFORM are automatic global build args provided by
# BuildKit — they must NOT be re-declared here with `ARG` (an empty re-declaration
# blanks them, making `--platform=$BUILDPLATFORM` invalid and failing the build).
#
# Base image: node:24-alpine. Until v1.8.1 the build and runtime stages used
# node:24-bookworm-slim (Debian 12). A trivy scan of the v1.8.1 image found
# ~350 OS package CVEs there, most with no Debian fix available, while
# node:24-alpine had a single (fixable) one. Flame never shells out, so it
# needs nothing from the OS beyond musl, libstdc++ and curl for the
# healthcheck. See docs/IMAGE_CVE_REVIEW.md.

### Client build (runs on host arch)
FROM --platform=$BUILDPLATFORM node:24-alpine AS clientbuilder
WORKDIR /app/client
COPY client/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY client/ ./
RUN npm run build

### Server build (target arch)
FROM --platform=$TARGETPLATFORM node:24-alpine AS builder
RUN apk add --no-cache python3 make g++

WORKDIR /app
ENV NODE_ENV=production npm_config_jobs=4 npm_config_python=/usr/bin/python3
COPY package*.json ./
# Build sqlite3 from source instead of using its published prebuilt, so the
# binary always matches this image's libc on every target arch. sqlite3 uses
# its bundled SQLite amalgamation, so no system libsqlite3 is needed at runtime.
# Install scripts are skipped and sqlite3 (the only production dependency with
# one) is compiled with node-gyp directly. npm 11 deprecates the old
# `--build-from-source` flag and npm 12 will drop it.
RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/root/.cache/node-gyp \
    npm ci --omit=dev --ignore-scripts \
    && cd node_modules/sqlite3 && npm run rebuild

# Bring in server sources
COPY . .

# client assets => /app/public
RUN mkdir -p /app/public
COPY --from=clientbuilder /app/client/dist/ /app/public/

# no client sources
RUN rm -rf /app/client

### Runtime
FROM node:24-alpine
# - `apk upgrade` picks up Alpine security fixes released after the base image
#   was built.
# - curl is kept for the HEALTHCHECK below and for existing docker-compose
#   files that call `curl -fs http://localhost:5005/health`.
# - npm, npx, corepack and yarn are removed: the server runs with plain
#   `node server.js` and never uses them, and their bundled dependencies
#   (undici, tar, brace-expansion, ip-address, ...) were the source of every
#   Node.js CVE in the v1.8.1 scan.
RUN apk upgrade --no-cache \
    && apk add --no-cache curl \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
        /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
        /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-*

ENV NODE_ENV=production
WORKDIR /app
# Copy as root so the server code and node_modules stay read-only for the
# non-root `node` user. Only the directories the app writes to are chowned:
#   data/   config.json, secret.key, uploads, backups, SQLite DB
#   log/    access.log
#   public/ flame.css is rewritten at runtime when custom CSS is saved
COPY --from=builder /app /app
RUN mkdir -p /app/data /app/log \
    && chown -R node:node /app/data /app/log /app/public
USER node
EXPOSE 5005
HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
    CMD curl -fs http://localhost:5005/health || exit 1
CMD ["node", "server.js"]
